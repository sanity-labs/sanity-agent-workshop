{
  "name": "sanity-agent-workshop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n studio,app,functions -c '#f03e2f,#8b5cf6,#f5a623' 'pnpm --filter studio dev' 'pnpm --filter app dev' 'pnpm --filter @starter/functions build && sanity functions dev'",
    "build": "pnpm -r build",
    "bootstrap": "pnpm --filter studio bootstrap",
    "seed:reset": "pnpm --filter studio seed:reset",
    "verify": "pnpm --filter studio verify",
    "skills:sync": "rm -rf .claude/skills && cp -R skills .claude/skills",
    "skills:check": "diff -r skills .claude/skills",
    "typegen": "pnpm --filter studio typegen",
    "pretypecheck": "pnpm run typegen",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "validate": "sanity-template-validate",
    "verify:offline": "tsx studio/scripts/verify.ts --offline"
  },
  "devDependencies": {
    "@sanity/blueprints": "^0.24.0",
    "@sanity/client": "catalog:",
    "@sanity/template-validator": "^3.1.1",
    "@starter/eslint-config": "workspace:*",
    "@types/node": "^22.19.13",
    "concurrently": "^9.2.1",
    "eslint": "^10.10.0",
    "oxfmt": "^0.66.0",
    "sanity": "catalog:",
    "tsx": "^4.23.13"
  },
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "packageManager": "pnpm@10.30.3"
}

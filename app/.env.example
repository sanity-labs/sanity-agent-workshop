# Copy to .env.local. `pnpm bootstrap` fills most of these in for you.

# Sanity project — set by bootstrap
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server-side project read token (Viewer) for rendering the menu page from a
# private dataset. Created by bootstrap. Never reaches the browser.
SANITY_READ_TOKEN=

# Anthropic API key — powers the chat model once the agent is wired
# (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# ─── Do this before you arrive (see the pre-flight email) ─────────────────
# 1. Enable Context for your org: Manage > your org > Apps
# 2. Create an ORGANIZATION API token with Context Viewer permissions:
#    Manage > API > Tokens, at the organization level — NOT a project token.
#    A project token is refused with 403 contextGrantRequired.
#    It carries org-level permissions, so it stays server-side. Always.
SANITY_ORGANIZATION_ID=
SANITY_ORGANIZATION_TOKEN=

# ─── You fill these in during the workshop ────────────────────────────────
# Mission 1-1: the MCP you create in the Context app, with your project +
# dataset as its source (GROQ mode).
# Shape: https://api.sanity.io/v1/context/organizations/<orgId>/mcp/<endpointName>
# The endpoint name is chosen at creation and CANNOT be changed afterwards.
# The Context app shows the full URL once you save. Bearer: SANITY_ORGANIZATION_TOKEN.
SANITY_CONTEXT_MCP_URL=

# PLAN B — if the Context app isn't available to you. The legacy project-addressed
# endpoint still serves the same GROQ tools. It needs a DEPLOYED Studio (say yes at
# bootstrap's deploy prompt, or `cd studio && npx sanity deploy`) and takes your
# PROJECT read token as the bearer instead of the org token. Bootstrap fills the URL in.
#   SANITY_CONTEXT_MCP_URL=<value of SANITY_CONTEXT_MCP_URL_FALLBACK>
#   SANITY_CONTEXT_MCP_TOKEN=<value of SANITY_READ_TOKEN>
# ?instructions= and ?groqFilter= work as URL parameters on this endpoint, so Missions
# 1-2 and 1-6 still work; you set them in the URL instead of in the Context app.
SANITY_CONTEXT_MCP_URL_FALLBACK=
# Optional: the bearer for SANITY_CONTEXT_MCP_URL. Leave empty to use SANITY_ORGANIZATION_TOKEN.
SANITY_CONTEXT_MCP_TOKEN=

# Mission 1-3: a second MCP in Knowledge Base mode, pointed at the Knowledge Base
# YOU build in your own organization — kb/README.md is the recipe; you start the
# build at the end of Mission 1-1. Same org as SANITY_CONTEXT_MCP_URL, so it uses
# SANITY_ORGANIZATION_TOKEN. Leave SANITY_CONTEXT_KB_TOKEN empty.
SANITY_CONTEXT_KB_URL=
# BACKUP ONLY — the shared, pre-built KB (build failed, still running, or Plan B).
# Its URL and this token are published in the workshop course. The token is a
# Context Viewer token for the FACILITATOR's organization, which is why it is a
# separate variable. When set, it is the bearer for SANITY_CONTEXT_KB_URL.
SANITY_CONTEXT_KB_TOKEN=
